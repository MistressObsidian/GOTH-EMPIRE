DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"
# Automatic payment request email. Keep both settings server-side.
# PAYMENT_EMAIL_FROM must be an address on a domain verified in Resend.
# The recipient stays ivyfoxasmr@outlook.com; do not use it as FROM unless verified.
RESEND_API_KEY=""
PAYMENT_EMAIL_FROM=""
# Production hosting settings; use your actual public origin.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
HOST=0.0.0.0
COOKIE_SECURE=true
# Hosting providers normally supply PORT automatically.
# Required for encrypted profiles, private messages, session details and content.
# Set to a cryptographically random 32-byte key encoded as 64 hexadecimal characters.
# Back up this key securely; never replace it without migrating encrypted records.
PORTAL_DATA_KEY=
