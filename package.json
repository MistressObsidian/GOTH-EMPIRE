{
  "name": "goth-empire",
  "private": true,
  "type": "module",
  "scripts": {
    "admin": "node scripts/admin.mjs",
    "start": "node server.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy": "wrangler deploy --keep-vars",
    "deploy:check": "wrangler deploy --dry-run --keep-vars",
    "preview:cloudflare": "wrangler dev",
    "test:cloudflare": "node --test tests/cloudflare.runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "payment-requests": "node scripts/payment-requests.mjs",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "check": "node --test tests/ui.test.mjs tests/runtime.test.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "wrangler": "4.152.0"
  }
}
