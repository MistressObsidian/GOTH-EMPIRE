{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goth-empire",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
